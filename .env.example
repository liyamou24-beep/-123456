# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional: leave empty when frontend and /api share the same origin (recommended in production).
# Dev: Vite proxies /api to the Node server on port 3001 (see vite.config.ts).
VITE_API_BASE=

# Optional dev bind: default is :: (IPv4+IPv6 dual-stack) so http://localhost works on Windows.
# If `npm run dev` fails to bind, try: VITE_DEV_HOST=0.0.0.0
# VITE_DEV_HOST=

# 与 server/.env 中 ADMIN_LIST_TOKEN 相同，供管理后台读取服务器上的注册列表
# VITE_ADMIN_LIST_TOKEN=
